/venv
*.json
*.jsonl
*.csv
/saves
/LLaMA-Factory
/merged
DataExport*/
ChatExport*/

# Tracked project config (re-include despite the broad *.json rule above)
!configs/dataset_info.json

# Synthetic demo input — safe to commit and needed for the reproducible demo.
# (Generated demo outputs like demo/sample_sharegpt.json stay ignored via *.json.)
!demo/sample_export.json

# Personal training/export overrides — copy a tracked config to *.local.yaml and
# edit that for your own model/hardware; it stays out of git.
configs/*.local.yaml

# Python cache / bytecode
__pycache__/
*.py[cod]

# Telegram API auth / secrets — never commit
*.session
*.session-journal
.env

# Telegram media / contacts — never commit (also covered inside DataExport*/)
*.vcard
*.tgs
*.webp
*.ogg
*.oga

# WhatsApp chat exports / media — never commit
# Android: "WhatsApp Chat with Alice.txt"; iPhone: "WhatsApp Chat - Alice.zip" containing _chat.txt
WhatsApp Chat*
_chat.txt
# Exported media: IMG-20200126-WA0001.jpg, PTT-20200126-WA0002.opus, ...
*-WA[0-9][0-9][0-9][0-9]*.*
*.opus
*.vcf

# Instagram "Download Your Information" exports — never commit
# The zip and its folder are named like instagram-<username>-2026-11-07-<id>
instagram-*/
instagram-*.zip
your_instagram_activity/

# Facebook / Messenger exports — never commit
# DYI zip and folder: facebook-<name>-2026-11-07-<id>; secure-storage (E2EE) download unzips
# to your_activity_across_facebook/ or a folder of <name>_N.json threads + media/
facebook-*/
facebook-*.zip
your_facebook_activity/
your_activity_across_facebook/

# LINE chat exports — never commit ("[LINE] Chat with Alice.txt", "[LINE] Aliceとのトーク.txt")
\[LINE\]*

# Signal chat exports (Export chat history) — never commit
signal-export-*/

# KakaoTalk chat exports — never commit
# Android/iOS: KakaoTalkChats.txt; Windows: KakaoTalk_<date>.txt; macOS: KakaoTalk_Chat_<name>.csv
KakaoTalkChats*.txt
KakaoTalk_*.txt
KakaoTalk_*.csv
Kakaotalk_Chat_*

# Demo recording intermediates (demo/record_demo.py)
demo/*.cast
