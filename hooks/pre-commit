#!/usr/bin/env bash
# Blocks accidental commits of chat-export data (Telegram, WhatsApp, Instagram, Messenger, LINE, Signal, KakaoTalk) / secrets, even if force-added.
# Enable once per clone with:  git config core.hooksPath hooks
# Bypass intentionally with:   git commit --no-verify
set -euo pipefail

# Patterns that must never be committed (regex, matched against staged paths)
BLOCK='(^|/)(result\.json|chat_dataset\.jsonl|chat_sharegpt\.json|elicited\.jsonl|eval_holdout\.jsonl|eval_holdout\.meta\.json|eval_generations\.json|eval_history\.jsonl)$|\.session(-journal)?$|(^|/)(DataExport|ChatExport)|(^|/)\.env$|\.(vcard|tgs|webp|ogg|oga|opus|vcf)$|(^|/)WhatsApp Chat|(^|/)_chat\.txt$|-WA[0-9]{4}[^/]*\.[^/]+$|(^|/)instagram-[^/]*(/|\.zip$)|(^|/)your_instagram_activity/|(^|/)facebook-[^/]*(/|\.zip$)|(^|/)your_(facebook_activity|activity_across_facebook)/|(^|/)\[LINE\][^/]*$|(^|/)signal-export-[^/]*/|(^|/)(KakaoTalkChats[^/]*\.txt|KakaoTalk_[^/]*\.(txt|csv)|Kakaotalk_Chat_[^/]*)$'

staged=$(git diff --cached --name-only --diff-filter=AM)
offenders=$(printf '%s\n' "$staged" | grep -E "$BLOCK" || true)

if [ -n "$offenders" ]; then
  echo "ERROR: refusing to commit chat-export data / secret files:" >&2
  printf '%s\n' "$offenders" | sed 's/^/  - /' >&2
  echo "" >&2
  echo "These contain private chat data or auth tokens. If this is truly" >&2
  echo "intentional, bypass with: git commit --no-verify" >&2
  exit 1
fi
